{
    "title" : "alinkiot",
    "author" : "uzyiot team",
    "root": "./docs",
    "plugins": [
        "expandable-chapters", "chapter-fold","splitter","code","github","-lunr", 
        "-search", "search-pro","-sharing", "sharing-plus",
        "tbfed-pagefooter", "-font-settings", "hide-element","-livereload",
        "pdf-download"
    ],    
    "pluginsConfig": {  
        "pdf-download": {
            "file": "assets/alinkiot.pdf",
            "label": "下载 PDF"
        },
        "hide-element": { "elements": [".gitbook-link"] },
        "github": {
            "url": "https://github.com/alinkiot/alinkiot"
        },
        "theme-default":{
            "showLevel": true
        },
        "tbfed-pagefooter": {
            "copyright":"alinkiot",
            "modify_label": "最后修改时间：",
            "modify_format": "YYYY-MM-DD HH:mm:ss"
        }
    }  
  }